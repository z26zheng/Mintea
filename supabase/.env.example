# Secrets for the Edge Functions.
#
# If you have credentials-vault access, its install.sh writes .env.local for you
# and you can ignore this file. Otherwise:
#
# Local:  copy to supabase/.env.local and run `npm run fn:serve`
# Hosted: supabase secrets set --env-file supabase/.env.local
#
# These values never reach the app bundle. Do not put them in apps/mintea/.env.
# Production Plaid keys do not belong in the vault — only in Supabase's own
# Edge Function secrets, set directly by the maintainer.

# Shared across both environments; only the secret differs.
PLAID_CLIENT_ID=

# One secret per Plaid environment. Both can be set at once: which one a call
# uses is decided by the household it belongs to (`households.plaid_environment`
# in the database), not by anything in this file. That is what lets a sandbox
# test household and real production households share one deployment.
#
# Set only the environments you actually use.
PLAID_SECRET_SANDBOX=
PLAID_SECRET_PRODUCTION=

# Legacy single-environment secret. Still read as a fallback when the
# environment-specific one above is absent, so an existing deployment keeps
# working; prefer the explicit names for anything new.
PLAID_SECRET=

# There is deliberately no PLAID_ENV. It used to select the environment for the
# whole deployment, which made it impossible to test against Sandbox while real
# households were syncing — and, because the code defaulted to sandbox when it
# was unset, a single missing value would silently point production access
# tokens at the wrong host. The environment now lives on the household and on
# each stored Item instead. To move a household, update it as the operator:
#
#   update households set plaid_environment = 'sandbox' where id = '…';
#
# Clients cannot write that column; the grant is restricted to `name`.

# Comma-separated ISO country codes Link should offer.
PLAID_COUNTRY_CODES=US

# Required for OAuth banks on web. Must exactly match an allowed redirect URI
# registered in the Plaid dashboard, e.g. http://localhost:8081/link/oauth
PLAID_REDIRECT_URI=

# Required for OAuth banks on iOS: an https universal link the app claims,
# registered in the Plaid dashboard alongside the iOS bundle identifier.
# Falls back to PLAID_REDIRECT_URI when unset, which is only correct if the
# same URL is claimed by the app.
PLAID_IOS_REDIRECT_URI=

# Required for OAuth banks on Android, and must match the Android package name
# registered in the Plaid dashboard. Defaults to com.mintea.app.
PLAID_ANDROID_PACKAGE_NAME=com.mintea.app

# Real estate valuations (RentCast). Optional — without it, properties still
# work and are valued by hand; only the automatic refresh is disabled.
#
# Free tier is 50 calls/month with no card: https://app.rentcast.io/app/api
# One call per property per month keeps you well inside it.
RENTCAST_API_KEY=

# Transactional email (Resend). `log` is the safe local/E2E default and never
# contacts Resend; use `send` only in a controlled environment after verifying
# the sender domain. Server-side only: never expose this key through an
# EXPO_PUBLIC_* variable.
EMAIL_DELIVERY_MODE=log
RESEND_API_KEY=
EMAIL_FROM="Mintea <notifications@example.com>"
EMAIL_REPLY_TO="support@example.com"

# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically in the
# hosted runtime. Set them here only for `supabase functions serve`.
