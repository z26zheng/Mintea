node_modules/
.expo/
dist/
web-build/
*.tsbuildinfo

# Native build output
apps/*/ios/
apps/*/android/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# Secrets — never commit
.env
.env.*
!.env.example
supabase/.env.local
supabase/.temp/

# The credentials vault belongs *beside* this checkout, not inside it. This is a
# safety net for when someone clones it here anyway: its files are named
# `*.env`, which none of the patterns above match, so without this line a
# routine `git add -A` would commit real keys to a public repository.
vault/

# OS / editor
.DS_Store
*.log
npm-debug.*
yarn-error.*
.idea/
.vscode/
.vercel/
.env.local

# Local visual QA renders and generated source artifacts
.artifacts/
