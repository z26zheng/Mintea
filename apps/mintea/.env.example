# Client configuration. Everything prefixed EXPO_PUBLIC_ is embedded in the
# app bundle and is therefore public by design.
#
# Copy to apps/mintea/.env.local and fill in from your Supabase project's
# API settings. The anon key is safe to ship: it grants nothing without a
# signed-in session, because every table is protected by row level security.
#
# The Plaid client secret and service-role key must NEVER appear in this file.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
